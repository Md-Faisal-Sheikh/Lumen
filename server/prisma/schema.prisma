// Prisma schema — SQLite by default for zero-config local dev.
// To use Postgres in production: set provider = "postgresql" and update DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  name          String
  color         String
  createdAt     DateTime        @default(now())
  memberships   ProjectMember[]
  ownedProjects Project[]       @relation("owner")
  chatSessions  ChatSession[]
  github        GitHubAccount?
}

// A user's connected GitHub account. The token is a personal access token the
// user pasted in — stored AES-256-GCM encrypted (see crypto.ts), never returned
// to the browser, and only ever decrypted server-side to make a request as them.
// One per user: the connection belongs to the person, while the repo it pushes
// to belongs to the project (GitHubLink below).
model GitHubAccount {
  userId      String   @id
  login       String // the GitHub username, shown in the UI
  avatarUrl   String?
  scopes      String // scopes GitHub reported for the token ("" for fine-grained)
  tokenCipher String // iv:tag:ciphertext, base64 — never leaves the server
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The repository a project pushes to. Set by the owner, used by whoever presses
// Push with their own connected account.
//
// `pushedPaths` is the file list of our last push. Without it a file deleted in
// Lumen would live on in the repo forever: we commit with `base_tree` so that
// files Lumen never wrote (a README, a LICENSE, a workflow) are never touched,
// which also means nothing is removed unless we ask for it explicitly. Knowing
// what we put there last time is what lets us ask.
model GitHubLink {
  projectId    String   @id
  owner        String // repo owner login
  repo         String // repo name
  branch       String   @default("main")
  pushedPaths  String   @default("[]") // JSON array of paths written by our last push
  lastCommitSha String?
  lastPushedAt DateTime?
  lastPushedBy String? // display name, so the room can see who pushed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Project {
  id        String          @id @default(cuid())
  name      String
  ownerId   String
  owner     User            @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Which engine runs this project's code. "web" is a static HTML/CSS/JS app in
  // a sandboxed iframe; "python" is CPython compiled to WebAssembly (Pyodide),
  // loaded inside that same iframe. It decides the build prompt, the entry file
  // (index.html vs main.py), and what the preview pane shows — so it belongs on
  // the project rather than being inferred from whatever files happen to exist.
  runtime   String          @default("web")

  // ── Distribution ──────────────────────────────────────────────────
  // A template is a project its owner has offered as a starting point: any
  // signed-in user may fork it, nobody may edit it. Ordinary projects stay
  // forkable by their members only.
  isTemplate  Boolean       @default(false)
  description String?       // shown on the template card; owner-written
  forkCount   Int           @default(0)
  // Where this project came from, if it was forked. Kept as a plain id rather
  // than a self-relation: the source may be deleted later, and losing the
  // provenance string is better than either cascading the delete or blocking it.
  forkedFromId   String?
  forkedFromName String?

  members   ProjectMember[]
  versions  Version[]
  doc       Doc?
  chats     ChatSession[]
  publication Publication?
  github    GitHubLink?

  @@index([isTemplate, updatedAt])
}

// A project published to a public link. The HTML is a snapshot taken when the
// owner pressed Publish — never the live document — so work in progress is
// never exposed and the link keeps working while the project is being changed.
// Held in its own table so the (potentially large) HTML is not dragged along by
// every ordinary project query.
model Publication {
  id        String   @id @default(cuid())
  projectId String   @unique
  slug      String   @unique // the /p/<slug> path; random suffix keeps it unguessable
  title     String
  html      String
  views     Int      @default(0)
  // Whether this page appears in the public gallery. Publishing is unlisted by
  // design — the random slug suffix exists precisely so a link cannot be guessed
  // from the project name — so being listed is a second, separate decision the
  // owner makes, never a side effect of pressing Publish.
  listed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([listed, updatedAt])
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  role      String  @default("editor") // "owner" | "editor"
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// Explicit snapshots saved on every successful build (version history).
model Version {
  id        String   @id @default(cuid())
  projectId String
  prompt    String
  html      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// A chat conversation saved for one user (their personal chat history).
// kind "auto" — the live, continuously auto-saved session (one per user+project).
// kind "manual" — an explicit snapshot taken by the user.
model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  title     String
  kind      String   @default("manual") // "auto" | "manual"
  messages  String // JSON-encoded array of chat messages
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Shared prompt → generated-code cache. When any user asks for a fresh build
// whose prompt matches one already generated (normalized), the code is served
// straight from the database instead of calling the AI again.
model BuildCache {
  id          String   @id @default(cuid())
  promptKey   String // normalized prompt (lowercased, whitespace-collapsed)
  // Which runtime the cached output was generated for. Part of the key, not a
  // label: "snake game" means a canvas in an iframe under "web" and a terminal
  // loop under "python", and serving one for the other would be the cache's
  // worst failure mode — handing someone code that cannot run at all.
  runtime     String   @default("web")
  prompt      String // the original prompt as first typed
  output      String // full marker-format model output (every file)
  summary     String?
  hits        Int      @default(0) // every reuse, exact or similar
  similarHits Int      @default(0) // just the ones matched by similarity
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([promptKey, runtime])
}

// Running totals for the build cache, so its value is a number rather than a
// claim. One row; `lookups` is partitioned by the three outcomes.
model CacheStat {
  id          String   @id @default("global")
  lookups     Int      @default(0)
  exactHits   Int      @default(0)
  similarHits Int      @default(0)
  misses      Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt
}

// Binary Yjs document state, persisted by the Hocuspocus database extension.
model Doc {
  projectId String   @id
  data      Bytes
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
